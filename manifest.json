{
  "manifest_version": 3,
  "name": "MONHawk",
  "version": "2.2",
  "description": "Eyes on every chat: MON's Twitch and YouTube live chat in one window. Pin a message, zoom it, react.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open MONHawk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "monhawk@monhawk.local",
      "strict_min_version": "128.0"
    }
  }
}
